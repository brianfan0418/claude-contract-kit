        },
        {
          "name": "currency",
          "label": "幣別",
          "type": "string",
          "required": false,
          "from_text": true,
          "description": "記錄合約原文的幣別或明示代碼；符號有歧義時回報待確認，不從對方所在地推定。原文未載明則留空，citations 保留原文。",
          "source": "本工具自訂的原文幣別欄位"
        },
        {
          "name": "value_basis",
          "label": "金額基礎",
          "type": "string",
          "required": false,
          "from_text": true,
          "description": "總額／年額／月額／單價／未載明。",
