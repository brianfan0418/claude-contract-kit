    "schema": {
      "version": 2,
      "note": "register.csv 的列舉欄位儲存 label（中文），code 供程式與外部系統對照。日期一律 YYYY-MM-DD。",
      "fields": [
        {
          "name": "contract_id",
          "label": "合約編號",
          "type": "string",
          "required": true,
          "from_text": false,
          "description": "主鍵。格式 C-西元年-四位流水號，例 C-2026-0001；一份合約一個編號，續約另編新號並以 prior_contract_id 連結上期。",
          "source": "本工具自訂的合約管理欄位"
        },
        {
          "name": "title",
          "label": "合約名稱",
          "type": "string",
          "required": true,
          "from_text": true,
          "description": "合約封面或首頁所載名稱；未載明時以「對象＋類型」自擬並於 notes 註明。",
          "source": "CUAD:Document Name"
        },
        {
          "name": "contract_type",
          "label": "合約類型",
          "type": "enum",
          "required": true,
          "from_text": false,
          "description": "依交易內容與使用者確認選一個主要類型；附約用 parent_contract_id 連結主約。跨多種類型者在 notes 記次要類型。舊值「經銷代理」須由使用者依市場確認改為國內經銷或海外經銷，不自動推定。",
          "source": "本工具自訂的台灣製藥／生技／化妝品業分類，非 CUAD 類別",
          "enum": "contract_type"
        },
        {
          "name": "department",
          "label": "承辦部門",
          "type": "enum",
          "required": true,
          "from_text": false,
          "description": "負責該合約的部門，分類見 fields.json 的 department；各公司應依組織調整。",
          "source": "本工具自訂的合約管理欄位",
          "enum": "department"
        },
        {
          "name": "owner",
          "label": "承辦人",
          "type": "string",
          "required": false,
          "from_text": false,
          "description": "合約的日常承辦人姓名或職稱，供提醒對象使用。",
          "source": "本工具自訂的合約管理欄位"
        },
        {
          "name": "our_entity",
          "label": "本方簽約主體",
          "type": "string",
          "required": true,
          "from_text": true,
