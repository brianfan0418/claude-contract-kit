          "source": "CUAD:Governing Law"
        },
        {
          "name": "jurisdiction",
          "label": "管轄法院或仲裁",
          "type": "string",
          "required": false,
          "from_text": true,
          "description": "舊版相容匯總欄位；新登錄留空，改填 dispute_resolution、dispute_forum 與 dispute_location。舊值不自動拆分，須回原文核對。",
          "source": "本工具自訂的合約管理欄位"
