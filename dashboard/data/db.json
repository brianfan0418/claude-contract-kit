        {
          "name": "contract_language",
          "label": "合約語言",
          "type": "string",
          "required": false,
          "from_text": true,
          "description": "記錄實際提供的合約語言；多語版本並列，另於 key_clauses 引用優先版本約定；原文未指定優先版本時不推定。",
          "source": "本工具自訂的涉外合約欄位"
