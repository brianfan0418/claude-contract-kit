{
  "version": 1,
  "note": "register.csv 的列舉欄位儲存 label（中文），code 供程式與外部系統對照。日期一律 YYYY-MM-DD。",
  "fields": [
    {
      "name": "contract_id",
      "label": "合約編號",
      "type": "string",
      "required": true,
      "from_text": false,
      "description": "主鍵。格式 C-西元年-四位流水號，例 C-2026-0001；一份合約一個編號，續約另編新號並以 prior_contract_id 連結上期。",
      "source": "CLM 通行欄位（Contract ID）"
    },
    {
      "name": "title",
      "label": "合約名稱",
      "type": "string",
      "required": true,
      "from_text": true,
      "description": "合約封面或首頁所載名稱；未載明時以「對象＋類型」自擬並於 notes 註明。",
      "source": "CUAD:Document Name"
    },
    {
      "name": "contract_type",
      "label": "合約類型",
      "type": "enum",
      "required": true,
      "from_text": false,
      "description": "分類代碼見 fields.json 的 contract_type。",
      "source": "CLM 通行欄位（Contract Type）",
      "enum": "contract_type"
    },
    {
      "name": "department",
      "label": "承辦部門",
      "type": "enum",
      "required": true,
      "from_text": false,
      "description": "負責該合約的部門，分類見 fields.json 的 department；各公司應依組織調整。",
      "source": "CLM 通行欄位（Business Unit / Department）",
      "enum": "department"
    },
    {
      "name": "owner",
      "label": "承辦人",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "合約的日常承辦人姓名或職稱，供提醒對象使用。",
      "source": "CLM 通行欄位（Contract Owner）"
    },
    {
      "name": "our_entity",
      "label": "本方簽約主體",
      "type": "string",
      "required": true,
      "from_text": true,
      "description": "本公司簽約的法人全名。",
      "source": "CUAD:Parties"
    },
    {
      "name": "counterparty_name",
      "label": "對象名稱",
      "type": "string",
      "required": true,
      "from_text": true,
      "description": "相對人法人或自然人全名，以合約首頁或簽章頁為準。",
      "source": "CUAD:Parties"
    },
    {
      "name": "counterparty_category",
      "label": "對象類別",
      "type": "enum",
      "required": true,
      "from_text": false,
      "description": "分類見 fields.json 的 counterparty_category。",
      "source": "CLM 通行欄位（Counterparty Type）",
      "enum": "counterparty_category"
    },
    {
      "name": "counterparty_tax_id",
      "label": "對象統一編號",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "相對人統一編號或身分證明字號；未載明時留空。",
      "source": "本工具自訂"
    },
    {
      "name": "status",
      "label": "狀態",
      "type": "enum",
      "required": true,
      "from_text": false,
      "description": "分類見 fields.json 的 status；到期與否由面板依日期計算，不另存。",
      "source": "CLM 通行欄位（Contract Status / Lifecycle Stage）",
      "enum": "status"
    },
    {
      "name": "signing_date",
      "label": "簽署日",
      "type": "date",
      "required": false,
      "from_text": true,
      "description": "最後一方簽署之日，格式 YYYY-MM-DD。",
      "source": "CUAD:Agreement Date"
    },
    {
      "name": "effective_date",
      "label": "生效日",
      "type": "date",
      "required": false,
      "from_text": true,
      "description": "合約約定的起算日，格式 YYYY-MM-DD。",
      "source": "CUAD:Effective Date"
    },
    {
      "name": "end_date",
      "label": "到期日",
      "type": "date",
      "required": false,
      "from_text": true,
      "description": "現行期間的屆滿日；無固定期限者留空並將 renewal_type 設為「無固定期限」。",
      "source": "CUAD:Expiration Date"
    },
    {
      "name": "renewal_type",
      "label": "續約方式",
      "type": "enum",
      "required": true,
      "from_text": true,
      "description": "自動續約／書面續約／不續約／無固定期限／未載明。",
      "source": "CUAD:Renewal Term",
      "enum": "renewal_type"
    },
    {
      "name": "renewal_term_months",
      "label": "續約期間（月）",
      "type": "integer",
      "required": false,
      "from_text": true,
      "description": "每次續約延長的月數；未載明留空。",
      "source": "CUAD:Renewal Term"
    },
    {
      "name": "notice_days",
      "label": "通知期限（天）",
      "type": "integer",
      "required": false,
      "from_text": true,
      "description": "不續約或終止須提前通知的天數；通知截止日 = 到期日 - 通知期限，由面板計算。",
      "source": "CUAD:Notice to Terminate Renewal"
    },
    {
      "name": "termination_for_convenience",
      "label": "無因終止權",
      "type": "enum",
      "required": false,
      "from_text": true,
      "description": "有（雙方）／有（僅本方）／有（僅對方）／無／未載明。",
      "source": "CUAD:Termination for Convenience",
      "enum": "termination_for_convenience"
    },
    {
      "name": "contract_value",
      "label": "合約金額",
      "type": "number",
      "required": false,
      "from_text": true,
      "description": "合約總額或年額（於 value_basis 註明）；無金額者留空。",
      "source": "CLM 通行欄位（Contract Value）"
    },
    {
      "name": "currency",
      "label": "幣別",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "ISO 4217 三碼，例 TWD、USD、CNY。",
      "source": "ISO 4217"
    },
    {
      "name": "value_basis",
      "label": "金額基礎",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "總額／年額／月額／單價／未載明。",
      "source": "本工具自訂"
    },
    {
      "name": "payment_terms",
      "label": "付款條件",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "付款時點與期限摘要，例「月結 60 天」。",
      "source": "CLM 通行欄位（Payment Terms）"
    },
    {
      "name": "liability_cap",
      "label": "責任上限",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "責任上限條款摘要（金額或倍數、例外）；無上限寫「無上限」，未載明寫「未載明」。",
      "source": "CUAD:Cap on Liability / Uncapped Liability"
    },
    {
      "name": "governing_law",
      "label": "準據法",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "準據法所載法域，例「中華民國法」。",
      "source": "CUAD:Governing Law"
    },
    {
      "name": "jurisdiction",
      "label": "管轄法院或仲裁",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "約定管轄法院或仲裁機構與地點。",
      "source": "CLM 通行欄位（Dispute Resolution / Jurisdiction）"
    },
    {
      "name": "assignment_restriction",
      "label": "轉讓限制",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "轉讓、控制權變更限制摘要。",
      "source": "CUAD:Anti-Assignment / Change of Control"
    },
    {
      "name": "involves_personal_data",
      "label": "涉及個資",
      "type": "enum",
      "required": false,
      "from_text": true,
      "description": "是／否／未載明。",
      "source": "本工具自訂",
      "enum": "involves_personal_data"
    },
    {
      "name": "confidentiality",
      "label": "保密條款",
      "type": "enum",
      "required": false,
      "from_text": true,
      "description": "有／無／未載明。",
      "source": "CLM 通行欄位（Confidentiality）",
      "enum": "confidentiality"
    },
    {
      "name": "prior_contract_id",
      "label": "上期合約編號",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "續約時指向被取代的上期 contract_id。",
      "source": "CLM 通行欄位（Renewal Chain）"
    },
    {
      "name": "parent_contract_id",
      "label": "主約編號",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "補充協議、訂單、附件所屬的主約 contract_id。",
      "source": "CLM 通行欄位（Parent / Child Agreement）"
    },
    {
      "name": "obligations",
      "label": "主要義務與里程碑",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "需追蹤的義務（交付、付款、報告、保險、稽核）與日期，以「日期：事項」逐項、以 | 分隔。",
      "source": "CLM 通行欄位（Obligation Management）"
    },
    {
      "name": "toc",
      "label": "章節目錄",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "章節與條號清單，以 | 分隔，例「第1條 定義 | 第2條 服務範圍」。",
      "source": "本工具自訂"
    },
    {
      "name": "key_clauses",
      "label": "關鍵條款摘要",
      "type": "string",
      "required": false,
      "from_text": true,
      "description": "關鍵條款的條號與摘要，以 | 分隔，例「第8條：責任上限為前12個月已付費用」。",
      "source": "本工具自訂"
    },
    {
      "name": "risk_level",
      "label": "初審風險等級",
      "type": "enum",
      "required": false,
      "from_text": false,
      "description": "低／中／高／未審；由 contract-review 寫入，人工覆核後才視為定案。",
      "source": "本工具自訂",
      "enum": "risk_level"
    },
    {
      "name": "last_review_date",
      "label": "最近審閱日",
      "type": "date",
      "required": false,
      "from_text": false,
      "description": "最近一次審閱完成日。",
      "source": "本工具自訂"
    },
    {
      "name": "source_refs",
      "label": "欄位出處",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "各欄位的原文出處，格式「欄位=頁碼/條號」，以 | 分隔；由 contract-intake 寫入。",
      "source": "本工具自訂"
    },
    {
      "name": "file_path",
      "label": "原檔位置",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "最終簽署版原檔所在位置或連結。",
      "source": "CLM 通行欄位（Document Repository Link）"
    },
    {
      "name": "notes",
      "label": "備註",
      "type": "string",
      "required": false,
      "from_text": false,
      "description": "其他須記錄的事項。",
      "source": "CLM 通行欄位"
    },
    {
      "name": "updated_at",
      "label": "最後更新日",
      "type": "date",
      "required": true,
      "from_text": false,
      "description": "主檔此列最後修改日。",
      "source": "CLM 通行欄位"
    }
  ],
